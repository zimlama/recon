# =============================================================================
# zimlama recon — backend environment variables (example)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# This file lives next to `.env.test` and is the backend-specific analog of
# the project-root `.env.example`. Backend-only vars live here; shared vars
# (LLM keys, CORS origins, database URL) live in the root `.env.example`.
# =============================================================================

# -----------------------------------------------------------------------------
# OPTIONAL — API authentication (Bearer token, audit finding C1)
# If unset, all routes are open (dev mode). If set, every business route
# requires 'Authorization: Bearer <RECON_API_KEY>'. Health, docs, openapi,
# and redoc stay public.
# Generate a strong random token, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# -----------------------------------------------------------------------------
# RECON_API_KEY=

# -----------------------------------------------------------------------------
# Free tools only — PR 2 (touch_classification)
# When true, modules with `requires_paid=True` are excluded from MODULE_REGISTRY
# at startup. The default is false (allow all modules). Invalid string values
# fall back to false (fail-open). See:
#   openspec/changes/2026-10-12-pr2-touch-classification/spec.md (REQ-030)
# Example values: true / false
# TOOLS_ONLY_FREE=false

# -----------------------------------------------------------------------------
# Rules-of-Engagement enforcement (PR 1)
# When true, RoEMiddleware enforces scope + sign-off on POST /api/v1/jobs.
# Read once at app construction; flip by restarting the process. The
# middleware is a no-op when this is unset or set to anything other than
# the literal "true" (case-insensitive). When enabled, requests without
# an active RoE for the named target are rejected with 403.
# -----------------------------------------------------------------------------
# ROE_ENABLED=false
# ROE_SESSION_FACTORY=

# -----------------------------------------------------------------------------
# Person-dossier encryption key (PR 4)
# Fernet key used by the person_dossier module to encrypt raw emails at rest
# in the `identity_map` table (AES-128-CBC + HMAC-SHA256). The plaintext
# email NEVER crosses this boundary — only the SHA-256 hash is used as a
# cross-module identifier (logs, LLM prompts, handoff exports).
#
# When unset, dossiers still emit but `identity_map` rows are skipped (a
# warning is added to ModuleOutput.errors). v1 uses a single key — no
# rotation support (per spec.md REQ-020 §2 / Open Question Q5).
#
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
# PERSON_DOSSIER_ENCRYPTION_KEY=