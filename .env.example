# =============================================================================
# zimlama Recon Phase 1 — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — MiniMax M3.1-Flash-Preview (LLM provider for AI validation per module)
# Talks the Anthropic Messages API against MiniMax's Anthropic-compatible endpoint.
#
# Key acquisition:
#   M Plan (recommended for M3.1-Flash-Preview): https://platform.minimax.io/user-center/payment/token-plan
#   Pay-as-you-go (use MINIMAX_MODEL=MiniMax-M3 instead): https://platform.minimax.io/user-center/basic-information/interface-key
# -----------------------------------------------------------------------------
MINIMAX_API_KEY=sk-minimax-replace-with-real-key
MINIMAX_BASE_URL=https://api.minimax.io/anthropic/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash-Preview

# -----------------------------------------------------------------------------
# OPTIONAL — Tier 2 modules (work with free tier, no key required)
# Adding keys unlocks higher rate limits.
# -----------------------------------------------------------------------------
# SHODAN_API_KEY=
# CENSYS_API_ID=
# CENSYS_API_SECRET=
# HUNTER_API_KEY=
# SERP_API_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL — GitHub recon (raises rate limit from 60 to 5000 req/h)
# Generate at: https://github.com/settings/tokens (no scopes required for public)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — HIBP (Have I Been Pwned) for breach_data module
# Paid key raises rate limit from 10 to 100 req/min. Free tier works.
# -----------------------------------------------------------------------------
# HIBP_API_KEY=

# -----------------------------------------------------------------------------
# Database
# Default: SQLite at ./data/recon.db
# Override for PostgreSQL: postgresql://user:pass@host:5432/recon
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/recon.db

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production-this-is-only-for-local-dev
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Rate limiting (per-target, per-module)
RATE_LIMIT_RECON_RPS=10
RATE_LIMIT_RECON_BURST=20

# -----------------------------------------------------------------------------
# Frontend (Vite/Next.js)
# These are read at build time by Next.js
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=zimlama recon
NEXT_PUBLIC_BRAND=zimlama
